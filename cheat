-- §5 — DESYNC RESOLVER ENGINE (BEATS FAKE ANGLES & HITBOX SPOOFING)
-- ══════════════════════════════════════════════════════════════════════════════
--[[
    Mechanism: Reconstructs true authoritative server hitbox orientation using
    MovementV2 RuntimeKinematics velocity vector and animation look delta.
]]

local ResolverState = {
    EntityData = {}, -- [combatant] = { MissCount = 0, LastResolvedYaw = 0, ResolvedMode = "" }
}

function Bloxstrike:ResolveTrueHitbox(combatant, character, rootPart, head)
    if not Config.Features.Resolver.Enabled then
        return head.Position, rootPart.CFrame
    end

    local data = ResolverState.EntityData[combatant]
    if not data then
        data = { MissCount = 0, LastResolvedYaw = 0, Inverted = false }
        ResolverState.EntityData[combatant] = data
    end

    -- 1. Query authoritative kinematics from MovementV2
    local vel, horizVel, speed, velY, onGround, isTracked = RuntimeKinematics.resolve(combatant, rootPart)
    local renderedYaw = select(2, rootPart.CFrame:ToEulerAnglesYXZ())
    local trueYaw = renderedYaw
    local resolvedMode = Config.Features.Resolver.Mode

    if resolvedMode == "AdaptiveAuto" then
        -- Automatically switch to inverted fake if consecutive shots miss
        if data.MissCount >= Config.Features.HitVerifier.AutoCorrectOnMisses then
            resolvedMode = "InvertedFake"
        elseif speed > 1.5 then
            resolvedMode = "KinematicVelocity"
        else
            resolvedMode = "AnimationYawDelta"
        end
    end

    if resolvedMode == "KinematicVelocity" and speed > 1.2 then
        -- Movement vector is authoritative: player cannot desync heading while moving fast
        trueYaw = math.atan2(-horizVel.X, -horizVel.Z)
    elseif resolvedMode == "AnimationYawDelta" then
        -- Compare Head look vector with root orientation to detect decoupled fake angles
        local headLook = head.CFrame.LookVector
        local headYaw = math.atan2(-headLook.X, -headLook.Z)
        local delta = math.abs(math.deg(headYaw - renderedYaw))
        if delta > Config.Features.Resolver.DesyncThresholdDegrees then
            -- Severe angle disparity detected: real hitbox stays near eye center
            trueYaw = headYaw
        end
    elseif resolvedMode == "InvertedFake" then
        -- Invert rendered yaw by 180 or opposite desync side
        trueYaw = renderedYaw + math.pi
    end

    data.LastResolvedYaw = trueYaw
    data.ResolvedMode = resolvedMode

    -- Reconstruct authoritative Root CFrame and Head Position
    local resolvedRootCF = CFrame.new(rootPart.Position) * CFrame.Angles(0, trueYaw, 0)
    local forwardVec = resolvedRootCF.LookVector
    local resolvedHeadPos = rootPart.Position + Vector3.new(0, Config.Features.Resolver.HeadOffsetHeight, 0)
        + (forwardVec * Config.Features.Resolver.HeadOffsetForward)

    return resolvedHeadPos, resolvedRootCF
end

