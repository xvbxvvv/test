-- §9 — ANTI-AIM & FAKE-ANGLE DESYNC ENGINE
-- ══════════════════════════════════════════════════════════════════════════════
--[[
    Mechanism: Manipulates outbound MovementV2 OwnerSnapshot LookYaw/VerticalLook
    bytes, presenting a spoofed visual model to enemy aimbots while preserving server state.
]]

local AntiAimState = {
    CurrentSpinAngle = 0,
    JitterFlip = false,
    DesyncFlip = false,
}

function Bloxstrike:GenerateAntiAimAngles(cameraCF)
    if not Config.Features.AntiAim.Enabled then
        return nil, nil
    end

    local baseYaw = select(2, cameraCF:ToEulerAnglesYXZ())
    local fakeYaw = baseYaw
    local fakePitch = 0

    -- 1. Resolve Fake Yaw
    local mode = Config.Features.AntiAim.YawMode
    if mode == "Backward" then
        fakeYaw = baseYaw + math.pi
    elseif mode == "Jitter" then
        AntiAimState.JitterFlip = not AntiAimState.JitterFlip
        local delta = math.rad(Config.Features.AntiAim.JitterDelta)
        fakeYaw = baseYaw + (AntiAimState.JitterFlip and delta or -delta)
    elseif mode == "Spin" then
        AntiAimState.CurrentSpinAngle = (AntiAimState.CurrentSpinAngle + math.rad(Config.Features.AntiAim.SpinSpeed)) % (2 * math.pi)
        fakeYaw = baseYaw + AntiAimState.CurrentSpinAngle
    elseif mode == "DesyncFlip" then
        AntiAimState.DesyncFlip = not AntiAimState.DesyncFlip
        fakeYaw = baseYaw + (AntiAimState.DesyncFlip and math.rad(90) or math.rad(-90))
    end

    -- 2. Resolve Fake Pitch
    local pitchMode = Config.Features.AntiAim.PitchMode
    if pitchMode == "Down" then
        fakePitch = math.rad(-89)
    elseif pitchMode == "Up" then
        fakePitch = math.rad(89)
    elseif pitchMode == "Zero" then
        fakePitch = 0
    elseif pitchMode == "Jitter" then
        fakePitch = AntiAimState.JitterFlip and math.rad(-89) or math.rad(89)
    end

    return fakeYaw, fakePitch
end

