-- §7 — PENETRATION & WALLBANG SOLVER (AUTO-WALL ENGINE)
-- ══════════════════════════════════════════════════════════════════════════════
--[[
    Mechanism: Traces obstacles along bullet trajectory, computes material thickness
    via bidirectional raycasting, and checks against weapon penetration capacity.
]]

function Bloxstrike:EvaluatePenetration(origin, targetPos, weaponPenetration)
    if not Config.Features.Wallbang.Enabled then
        local isVis = self:IsDirectVisible(origin, targetPos)
        return isVis, isVis and 100 or 0
    end

    local direction = targetPos - origin
    local totalDistance = direction.Magnitude
    if totalDistance <= 0.1 then return true, 100 end

    local unitDir = direction.Unit
    local ignoreList = GetRayIgnore()
    local accumulatedThickness = 0
    local maxPenetration = weaponPenetration or Config.Features.Wallbang.MaxPenetrationDepth

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = ignoreList
    rayParams.IgnoreWater = true
    rayParams.CollisionGroup = "Bullet"

    local currentOrigin = origin
    local remainingDist = totalDistance

    for step = 1, 4 do
        local hit = Workspace:Raycast(currentOrigin, unitDir * remainingDist, rayParams)
        if not hit then
            -- Reached target without further obstructions
            local damageFactor = math.clamp(1 - (accumulatedThickness / maxPenetration), 0.15, 1.0)
            local finalDamage = 100 * damageFactor
            return (finalDamage >= Config.Features.Wallbang.MinDamage), finalDamage
        end

        local hitPart = hit.Instance
        local hitPos = hit.Position

        -- Check material penetration capability from Bloxstrike database
        local matName = hitPart.Material.Name
        local matAllowance = Config.Features.Wallbang.MaterialLimits[matName] or Config.Features.Wallbang.MaterialLimits.Default

        if hitPart.Parent and hitPart.Parent:HasTag("BreakableDoor") and Config.Features.Wallbang.ThroughBreakableDoors then
            matAllowance = 25
        end

        if matAllowance <= 0 and maxPenetration <= 0 then
            return false, 0
        end

        -- Measure barrier depth via reverse raycast
        local reverseOrigin = hitPos + (unitDir * 10)
        local reverseRay = Workspace:Raycast(reverseOrigin, -unitDir * 10, rayParams)
        local exitPos = reverseRay and reverseRay.Position or (hitPos + unitDir * 0.5)
        local barrierThickness = (exitPos - hitPos).Magnitude

        accumulatedThickness = accumulatedThickness + barrierThickness

        if accumulatedThickness > maxPenetration + matAllowance then
            return false, 0 -- Exceeded allowable wallbang limit
        end

        -- Advance ray beyond obstacle
        currentOrigin = exitPos + (unitDir * 0.1)
        remainingDist = (targetPos - currentOrigin).Magnitude
        if remainingDist <= 0.2 then
            break
        end
    end

    local damageFraction = math.clamp(1 - (accumulatedThickness / maxPenetration), 0.15, 1.0)
    local estimatedDamage = 100 * damageFraction
    return (estimatedDamage >= Config.Features.Wallbang.MinDamage), estimatedDamage
end

function Bloxstrike:IsDirectVisible(origin, targetPos)
    local ignoreList = GetRayIgnore()
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = ignoreList
    rayParams.IgnoreWater = true

    local direction = targetPos - origin
    local result = Workspace:Raycast(origin, direction, rayParams)
    return (result == nil)
end

