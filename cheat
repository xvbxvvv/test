-- §6 — LAG COMPENSATION & BACKTRACK ENGINE
-- ══════════════════════════════════════════════════════════════════════════════
--[[
    Mechanism: Circular snapshot buffer storing per-combatant hitbox positions
    within the server's 200ms lag compensation window.
]]

local BacktrackBuffer = {} -- [combatant] = { { Timestamp, RootCF, HeadPos, Bones, Velocity } }

function Bloxstrike:UpdateBacktrackRecords()
    if not Config.Features.Backtrack.Enabled then return end

    local now = os.clock()
    local maxAge = Config.Features.Backtrack.WindowMs / 1000

    for _, ent in ipairs(CachedEntities) do
        if ent.IsEnemy then
            local combatant = ent.Combatant
            local records = BacktrackBuffer[combatant]
            if not records then
                records = {}
                BacktrackBuffer[combatant] = records
            end

            -- Prune outdated snapshots exceeding server rewind capacity
            for i = #records, 1, -1 do
                if now - records[i].Timestamp > maxAge then
                    table.remove(records, i)
                end
            end

            -- Capture current tick snapshot
            local bonePositions = {}
            for name, part in pairs(ent.Bones) do
                bonePositions[name] = part.Position
            end

            local resolvedHead, resolvedRootCF = self:ResolveTrueHitbox(combatant, ent.Character, ent.RootPart, ent.Head)

            table.insert(records, 1, {
                Timestamp = now,
                HeadPosition = resolvedHead,
                RootCFrame = resolvedRootCF,
                Bones = bonePositions,
                Velocity = ent.RootPart.AssemblyLinearVelocity,
                Distance = ent.DistanceCamera,
            })

            -- Maintain buffer size
            while #records > Config.Features.Backtrack.MaxRecordsPerEntity do
                table.remove(records)
            end
        end
    end
end

function Bloxstrike:FindBestBacktrackRecord(combatant, fovLimit)
    if not Config.Features.Backtrack.Enabled then return nil end

    local records = BacktrackBuffer[combatant]
    if not records or #records == 0 then return nil end

    local origin = CurrentCamera.CFrame.Position
    local viewportCenter = Vector2.new(CurrentCamera.ViewportSize.X / 2, CurrentCamera.ViewportSize.Y / 2)
    local bestRecord = nil
    local bestScore = math.huge

    for _, rec in ipairs(records) do
        local screenPos, onScreen = CurrentCamera:WorldToViewportPoint(rec.HeadPosition)
        if onScreen and screenPos.Z > 0 then
            local dist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
            if dist <= fovLimit then
                local isVis = self:IsVisible(origin, rec.HeadPosition, ent and ent.Head)
                -- Favor stationary or fully exposed records
                local speed = rec.Velocity.Magnitude
                local score = dist + (speed * 5) - (isVis and 200 or 0)
                if score < bestScore then
                    bestScore = score
                    bestRecord = rec
                end
            end
        end
    end

    return bestRecord
end

