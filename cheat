-- §8 — KINEMATIC LEAD PREDICTION ENGINE
-- ══════════════════════════════════════════════════════════════════════════════
--[[
    Mechanism: Leads moving targets by weapon flight time and network latency,
    solving ballistic parabolic trajectory for moving/jumping combatants.
]]

function Bloxstrike:PredictKinematicPosition(origin, targetPos, velocity, isAirborne, projectileSpeed)
    if not Config.Features.LeadPrediction.Enabled then
        return targetPos
    end

    local speed = projectileSpeed or Config.Features.LeadPrediction.DefaultProjectileSpeed
    local dist = (targetPos - origin).Magnitude

    -- Compute flight time and network latency delta
    local flightTime = (speed > 0 and speed < 10000) and (dist / speed) or 0
    local pingTime = Config.Features.LeadPrediction.AccountForPing and (Config.Features.LeadPrediction.FixedPingMs / 1000) or 0
    local totalLeadTime = flightTime + pingTime

    local predicted = targetPos + (velocity * totalLeadTime)

    -- Compensate vertical gravity drop if target is in air
    if isAirborne and Config.Features.LeadPrediction.AccountForGravity then
        local gravity = Workspace.Gravity
        local verticalDisplacement = (velocity.Y * totalLeadTime) - (0.5 * gravity * (totalLeadTime ^ 2))
        predicted = Vector3.new(predicted.X, targetPos.Y + verticalDisplacement, predicted.Z)
    end

    return predicted
end

