function BypassState:ConsumeShotToken()
    if not Config.Bypass.EnforceRateLimits then return true end
    local now = os.clock()
    local elapsed = now - self.LastShotTimestamp
    self.LastShotTimestamp = now
    self.ShotTokens = math.min(self.MaxShotTokens, self.ShotTokens + elapsed * self.RefillRate)

    if self.ShotTokens >= 1 then
        self.ShotTokens = self.ShotTokens - 1
        return true
    end
    return false
end

