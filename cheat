    if not Participants.IsAlive(combatant) then
        return false
    end

    local localTeam = self:GetLocalTeam()
    if localTeam == "FFA" then
        return true
    end

    local targetTeam = combatant:GetAttribute(Config.Attributes.Team)
    if targetTeam and (targetTeam == "Terrorists" or targetTeam == "Counter-Terrorists") then
        return targetTeam ~= localTeam
    end

    return false
