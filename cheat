-- §16 — UNLOAD & LIFECYCLE MANAGEMENT (REVERSE PATH)
-- ══════════════════════════════════════════════════════════════════════════════

function Bloxstrike:Unload()
    for _, conn in ipairs(RunConnections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(RunConnections)

    for _, unhook in ipairs(BypassState.Hooks) do
        pcall(unhook)
    end
    table.clear(BypassState.Hooks)

    if SilentFOVCircle then
        pcall(function() SilentFOVCircle:Remove() end)
        SilentFOVCircle = nil
    end

    if AimFOVCircle then
        pcall(function() AimFOVCircle:Remove() end)
        AimFOVCircle = nil
    end

    if HitHUD then
        pcall(function() HitHUD:Remove() end)
        HitHUD = nil
    end

    for _, drawings in pairs(ESPRegistry) do
        pcall(function()
            drawings.Box:Remove()
            drawings.BoxOutline:Remove()
            drawings.Name:Remove()
            drawings.Distance:Remove()
            drawings.HealthBar:Remove()
            drawings.HealthBarOutline:Remove()
            for _, line in ipairs(drawings.SkeletonLines) do line:Remove() end
        end)
    end
    table.clear(ESPRegistry)
    table.clear(BacktrackBuffer)
    table.clear(CachedEntities)

    print("[Bloxstrike::Core] Unloaded cleanly · Reverse path complete.")
end

