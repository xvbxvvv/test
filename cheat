-- §10 — MULTI-METRIC THREAT TARGET-PRIORITY RESOLVER
-- ══════════════════════════════════════════════════════════════════════════════
--[[
    Mechanism: Computes weighted threat scores across visible and wallbangable
    enemies, feeding a single authoritative target to Silent Aim, Aimbot, and Triggerbot.
]]

function Bloxstrike:EvaluateTargetThreat(ent, screenDist, fovLimit, isVisible, wallbangDamage)
    local myPos = CurrentCamera.CFrame.Position
    local enemyHead = ent.Head
    local threatScore = 0

    -- Metric 1: Threat factor — Is the enemy aiming at LocalPlayer?
    local enemyLook = enemyHead.CFrame.LookVector
    local dirToMe = (myPos - enemyHead.Position).Unit
    local aimDot = enemyLook:Dot(dirToMe)
    if aimDot > Config.Features.Priority.ThreatAngleThreshold then
        threatScore = threatScore + (Config.Features.Priority.AimingAtMeWeight * aimDot)
    end

    -- Metric 2: Crosshair proximity
    local fovFraction = math.clamp(1 - (screenDist / fovLimit), 0, 1)
    threatScore = threatScore + (Config.Features.Priority.CrosshairWeight * fovFraction)

    -- Metric 3: Vulnerability (Lowest health target prioritization)
    local healthFraction = math.clamp(1 - (ent.Health / ent.MaxHealth), 0, 1)
    threatScore = threatScore + (Config.Features.Priority.LowestHealthWeight * healthFraction)

    -- Metric 4: Exposure & Damage Viability
    local exposureFraction = isVisible and 1.0 or (wallbangDamage / 100)
    threatScore = threatScore + (Config.Features.Priority.ExposureWeight * exposureFraction)

    return threatScore
end

function Bloxstrike:ResolveTarget(options)
    local fovLimit = options.FOV or 120
    local partName = options.TargetPart or "Head"
    local origin = CurrentCamera.CFrame.Position
    local viewportCenter = Vector2.new(CurrentCamera.ViewportSize.X / 2, CurrentCamera.ViewportSize.Y / 2)
    local entities = self:UpdateEntityCache()

    local bestCandidate = nil
    local bestThreatScore = -math.huge

    for _, ent in ipairs(entities) do
        if ent.IsEnemy then
            local targetPart = (partName == "Head") and ent.Head or ent.RootPart
            local resolvedHead, resolvedRootCF = self:ResolveTrueHitbox(ent.Combatant, ent.Character, ent.RootPart, ent.Head)
            local baseHitPos = (partName == "Head") and resolvedHead or resolvedRootCF.Position

            -- Kinematic Lead Prediction
            local predictedHitPos = self:PredictKinematicPosition(
                origin,
                baseHitPos,
                ent.RootPart.AssemblyLinearVelocity,
                not ent.RootPart:GetAttribute("OnGround"),
                Config.Features.LeadPrediction.DefaultProjectileSpeed
            )

            local screenPos, onScreen = CurrentCamera:WorldToViewportPoint(predictedHitPos)

            if onScreen and screenPos.Z > 0 then
                local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude

                if screenDist <= fovLimit then
                    local isVis = self:IsDirectVisible(origin, predictedHitPos)
                    local canWallbang, wbDamage = false, 0

                    if not isVis and Config.Features.Wallbang.Enabled then
                        canWallbang, wbDamage = self:EvaluatePenetration(origin, predictedHitPos, 35)
                    end

                    if isVis or canWallbang or not options.VisibleOnly then
                        local threat = self:EvaluateTargetThreat(ent, screenDist, fovLimit, isVis, wbDamage)

                        if threat > bestThreatScore then
                            bestThreatScore = threat
                            bestCandidate = {
                                Entity = ent,
                                TargetPart = targetPart,
                                HitPosition = predictedHitPos,
                                ScreenPosition = Vector2.new(screenPos.X, screenPos.Y),
                                ScreenDistance = screenDist,
                                IsVisible = isVis,
                                IsWallbang = canWallbang,
                                WallbangDamage = wbDamage,
                                ThreatScore = threat,
                            }
                        end
                    end
                end
            end
        end
    end

    -- If no direct candidate found, check Backtrack Buffer
    if not bestCandidate and Config.Features.Backtrack.Enabled then
        for _, ent in ipairs(entities) do
            if ent.IsEnemy then
                local rec = self:FindBestBacktrackRecord(ent.Combatant, fovLimit)
                if rec then
                    local screenPos = CurrentCamera:WorldToViewportPoint(rec.HeadPosition)
                    bestCandidate = {
                        Entity = ent,
                        TargetPart = ent.Head,
                        HitPosition = rec.HeadPosition,
                        ScreenPosition = Vector2.new(screenPos.X, screenPos.Y),
                        ScreenDistance = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude,
                        IsVisible = true,
                        IsBacktrack = true,
                        BacktrackRecord = rec,
                    }
                    break
                end
            end
        end
    end

    return bestCandidate
end

-- ══════════════════════════════════════════════════════════════════════════════
-- §11 — HIT-REGISTRATION VERIFIER & TELEMETRY AUDITOR
-- ══════════════════════════════════════════════════════════════════════════════
--[[
    Mechanism: Audits outbound bullet timestamps against incoming CharacterDamaged
    events, catching silent server rejections and dynamically adapting resolver angles.
]]

local HitVerifierState = {
    TotalFired = 0,
    TotalHits = 0,
    TotalMisses = 0,
    PendingShots = {}, -- [id] = { Timestamp, Combatant, TargetPos }
    RecentMisses = 0,
    LastLatencyMs = 0,
}

function Bloxstrike:RegisterFiredShot(targetCandidate)
    if not Config.Features.HitVerifier.Enabled or not targetCandidate then return end

    HitVerifierState.TotalFired = HitVerifierState.TotalFired + 1
    local shotId = tostring(os.clock()) .. "_" .. tostring(HitVerifierState.TotalFired)

    HitVerifierState.PendingShots[shotId] = {
        Timestamp = os.clock(),
        Combatant = targetCandidate.Entity.Combatant,
        Candidate = targetCandidate,
    }

    -- Timeout watchdog: flag silent miss if server doesn't respond within window
    task.delay(Config.Features.HitVerifier.TimeoutMs / 1000, function()
        if HitVerifierState.PendingShots[shotId] then
            HitVerifierState.PendingShots[shotId] = nil
            HitVerifierState.TotalMisses = HitVerifierState.TotalMisses + 1
            HitVerifierState.RecentMisses = HitVerifierState.RecentMisses + 1

            -- Feedback loop: Auto-correct resolver angle on consecutive misses
            local entData = ResolverState.EntityData[targetCandidate.Entity.Combatant]
            if entData then
                entData.MissCount = entData.MissCount + 1
            end
        end
    end)
end

function Bloxstrike:InstallHitVerifier()
    local charFolder = ReplicatedStorage:FindFirstChild("NetworkRemotes") and ReplicatedStorage.NetworkRemotes:FindFirstChild("Character")
    local damagedRemote = charFolder and charFolder:FindFirstChild("CharacterDamaged")

    if damagedRemote then
        local conn = damagedRemote.OnClientEvent:Connect(function(packet)
            local victimUserId = packet and packet.VictimUserId
            local now = os.clock()

            for shotId, shot in pairs(HitVerifierState.PendingShots) do
                local combatant = shot.Combatant
                local avatarId = combatant:GetAttribute(Config.Attributes.AvatarUserId) or (combatant.UserId)

                if victimUserId == avatarId or not victimUserId then
                    HitVerifierState.LastLatencyMs = math.floor((now - shot.Timestamp) * 1000)
                    HitVerifierState.TotalHits = HitVerifierState.TotalHits + 1
                    HitVerifierState.RecentMisses = 0
                    HitVerifierState.PendingShots[shotId] = nil

                    local entData = ResolverState.EntityData[combatant]
                    if entData then
                        entData.MissCount = 0
                    end
                    break
                end
            end
        end)
        table.insert(BypassState.Hooks, function() conn:Disconnect() end)
    end
end

-- ══════════════════════════════════════════════════════════════════════════════
-- §12 — IN-SIMULATION BYPASS & SILENT AIM INJECTION
-- ══════════════════════════════════════════════════════════════════════════════

function Bloxstrike:InstallBypass()
    if BypassState.OriginalRaycast then return end

    -- Hook Bullet._performRaycast: Pure in-memory vector redirection without moving camera
    BypassState.OriginalRaycast = BulletClass._performRaycast
    BulletClass._performRaycast = function(bulletInstance, spreadAngle)
        if Config.Features.SilentAim.Enabled and ActiveSilentTarget and ActiveSilentTarget.HitPosition then
            -- Hit chance roll
            if Config.Features.SilentAim.HitChance < 100 and math.random(1, 100) > Config.Features.SilentAim.HitChance then
                return BypassState.OriginalRaycast(bulletInstance, spreadAngle)
            end

            -- Respect rate limit token bucket to prevent server-side drop
            if BypassState:ConsumeShotToken() then
                local ignoreList = GetRayIgnore()
                local origin = CurrentCamera.CFrame.Position
                local targetPos = ActiveSilentTarget.HitPosition
                local direction = (targetPos - origin).Unit
                local range = bulletInstance.Properties.Range or 500
                local penetration = bulletInstance.Properties.Penetration or 35

                -- Audit shot in Hit-Registration Verifier
                Bloxstrike:RegisterFiredShot(ActiveSilentTarget)

                -- Internal game raycaster execution
                local hitResult = RaycastModule.castThroughDistance(
                    origin,
                    direction * range,
                    penetration,
                    ignoreList
                )

                local hitsList = {}
                local totalDist = range
                local firstHit = hitResult[1]
                if firstHit then
                    totalDist = (firstHit.position - origin).Magnitude
                end

                for idx = 1, #hitResult do
                    local h = hitResult[idx]
                    if h.instance and h.material then
                        table.insert(hitsList, {
                            Position = h.position,
                            Instance = h.instance,
                            Material = h.material.Name,
                            Normal = h.normal or Vector3.new(0, 0, 0),
                            Exit = (idx % 2 == 0),
                        })
                    end
                end

                return {
                    Origin = origin,
                    Direction = direction,
                    Distance = totalDist,
                    Hits = hitsList,
                }
            end
        end

        return BypassState.OriginalRaycast(bulletInstance, spreadAngle)
    end

    table.insert(BypassState.Hooks, function()
        BulletClass._performRaycast = BypassState.OriginalRaycast
        BypassState.OriginalRaycast = nil
    end)

    -- Silence BAC Integrity Probe Remote
    if Config.Bypass.SilenceBAC then
        local bacRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("BAC")
        if not bacRemote and ReplicatedStorage:FindFirstChild("NetworkRemotes") then
            bacRemote = ReplicatedStorage.NetworkRemotes:FindFirstChild("BAC")
        end

        if bacRemote and hookfunction then
            local oldFire = bacRemote.FireServer
            hookfunction(bacRemote.FireServer, function(self, ...)
                if self == bacRemote then
                    return
                end
                return oldFire(self, ...)
            end)
            table.insert(BypassState.Hooks, function()
                hookfunction(bacRemote.FireServer, oldFire)
            end)
        elseif hookmetamethod then
            local oldNamecall
            oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
                local method = getnamecallmethod()
                if (method == "FireServer" or method == "fireServer") and (self == bacRemote or self.Name == "BAC") then
                    return
                end
                return oldNamecall(self, ...)
            end)
            table.insert(BypassState.Hooks, function()
                hookmetamethod(game, "__namecall", oldNamecall)
            end)
        end
    end

    -- Install Server Damage Telemetry Verifier
    self:InstallHitVerifier()
end

