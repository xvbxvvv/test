end

local SkeletonJoints = {
    {"Head", "UpperTorso"},
    {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "Torso"},
    {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"},
    {"LeftLowerArm", "LeftHand"},
    {"Torso", "Left Arm"},
    {"UpperTorso", "RightUpperArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"RightLowerArm", "RightHand"},
    {"Torso", "Right Arm"},
    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},
    {"Torso", "Left Leg"},
    {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
    {"RightLowerLeg", "RightFoot"},
    {"Torso", "Right Leg"},
}

function Bloxstrike:UpdateEntityCache()
    local now = os.clock()
    if now - LastEntityCacheUpdate < 0.016 then
        return CachedEntities
    end
    LastEntityCacheUpdate = now

    local entities = {}
    local allCombatants = Participants.GetAll()
    local localOrigin = CurrentCamera.CFrame.Position
    local localPlayerPos = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")) and LocalPlayer.Character.HumanoidRootPart.Position or localOrigin

    for _, combatant in ipairs(allCombatants) do
        local isBot = Participants.IsBot(combatant)
        if not isBot or Config.Features.ESP.ShowBots then
            local isEnemy = self:IsEnemy(combatant)
            if isEnemy or Config.Features.ESP.ShowTeammates then
                local character = Participants.Character(combatant)
                if character and character:IsDescendantOf(Workspace) and character:GetAttribute(Config.Attributes.Dead) ~= true then
                    local rootPart = CharacterResolver.getRootPart(character)
                    local head = CharacterResolver.getHead(character)
                    if rootPart and head then
                        local health = character:GetAttribute(Config.Attributes.Health) or 100
                        local maxHealth = character:GetAttribute(Config.Attributes.MaxHealth) or 100
                        local name = Participants.Name(combatant) or character.Name
                        local distStuds = (localOrigin - rootPart.Position).Magnitude
                        local distPlayer = (localPlayerPos - rootPart.Position).Magnitude
                        local bones = ResolveBones(character)

                        table.insert(entities, {
                            Combatant = combatant,
                            Character = character,
                            RootPart = rootPart,
                            Head = head,
                            Bones = bones,
                            Health = health,
                            MaxHealth = maxHealth,
                            Name = name,
                            IsBot = isBot,
                            IsEnemy = isEnemy,
                            DistanceCamera = distStuds,
                            DistancePlayer = distPlayer,
                        })
                    end
                end
            end
        end
    end

    CachedEntities = entities
    return entities
end

function Bloxstrike:UpdateVisuals()
    local center = Vector2.new(CurrentCamera.ViewportSize.X / 2, CurrentCamera.ViewportSize.Y / 2)

    -- FOV Primitives
    if SilentFOVCircle then
        SilentFOVCircle.Visible = Config.Features.SilentAim.Enabled and Config.Features.SilentAim.DrawFOV
        SilentFOVCircle.Radius = Config.Features.SilentAim.FOV
        SilentFOVCircle.Position = center
        SilentFOVCircle.Color = Config.Features.SilentAim.FOVColor
    end

    if AimFOVCircle then
        AimFOVCircle.Visible = Config.Features.Aimbot.Enabled and Config.Features.Aimbot.DrawFOV
        AimFOVCircle.Radius = Config.Features.Aimbot.FOV
        AimFOVCircle.Position = center
        AimFOVCircle.Color = Config.Features.Aimbot.FOVColor
    end

    -- Hit-Registration HUD Telemetry
    if not HitHUD then
        HitHUD = Drawing.new("Text")
        HitHUD.Size = 13
        HitHUD.Outline = true
        HitHUD.Color = Color3.fromRGB(0, 255, 170)
        HitHUD.Visible = false
    end

    if Config.Features.HitVerifier.DrawHUD and HitHUD then
        local acc = (HitVerifierState.TotalFired > 0) and math.floor((HitVerifierState.TotalHits / HitVerifierState.TotalFired) * 100) or 100
        HitHUD.Position = Config.Features.HitVerifier.HUDPosition
        HitHUD.Text = string.format("BloxStrike HvH Verifier: %d/%d hits (%d%%) · Ping: %dms · Resolver: %s",
            HitVerifierState.TotalHits, HitVerifierState.TotalFired, acc, HitVerifierState.LastLatencyMs, Config.Features.Resolver.Mode)
        HitHUD.Visible = true
    elseif HitHUD then
        HitHUD.Visible = false
    end

    if not Config.Features.ESP.Enabled then
        for _, d in pairs(ESPRegistry) do
            d.Box.Visible = false
            d.BoxOutline.Visible = false
            d.Name.Visible = false
            d.Distance.Visible = false
            d.HealthBar.Visible = false
            d.HealthBarOutline.Visible = false
            for _, l in ipairs(d.SkeletonLines) do l.Visible = false end
        end
        return
    end

    local entities = self:UpdateEntityCache()
    local presentCombatants = {}

    for _, ent in ipairs(entities) do
        presentCombatants[ent.Combatant] = true

        if ent.DistanceCamera <= Config.Features.ESP.MaxDistance then
            local drawings = ESPRegistry[ent.Combatant]
            if not drawings then
                drawings = CreateDrawings(ent)
                ESPRegistry[ent.Combatant] = drawings
            end

            local rootPos, onScreen = CurrentCamera:WorldToViewportPoint(ent.RootPart.Position)
            if onScreen and rootPos.Z > 0 then
                local headPos = CurrentCamera:WorldToViewportPoint(ent.Head.Position + Vector3.new(0, 0.6, 0))
                local legPos = CurrentCamera:WorldToViewportPoint(ent.RootPart.Position - Vector3.new(0, 3.0, 0))

                local height = math.abs(headPos.Y - legPos.Y)
                local width = height * 0.65
                local boxX = rootPos.X - (width / 2)
                local boxY = headPos.Y

                local color = ent.IsEnemy and (self:IsDirectVisible(CurrentCamera.CFrame.Position, ent.Head.Position) and Config.Features.ESP.EnemyVisibleColor or Config.Features.ESP.EnemyHiddenColor) or Config.Features.ESP.TeamColor

                -- 2D Bounding Box
                if Config.Features.ESP.Boxes then
                    drawings.BoxOutline.Size = Vector2.new(width, height)
                    drawings.BoxOutline.Position = Vector2.new(boxX, boxY)
                    drawings.BoxOutline.Visible = true

                    drawings.Box.Size = Vector2.new(width, height)
                    drawings.Box.Position = Vector2.new(boxX, boxY)
                    drawings.Box.Color = color
                    drawings.Box.Visible = true
                else
                    drawings.Box.Visible = false
                    drawings.BoxOutline.Visible = false
                end

                -- Name & Distance
                if Config.Features.ESP.Names then
                    drawings.Name.Text = ent.Name
                    drawings.Name.Position = Vector2.new(rootPos.X, boxY - 14)
                    drawings.Name.Visible = true
                else
                    drawings.Name.Visible = false
                end

                if Config.Features.ESP.Distance then
                    drawings.Distance.Text = string.format("%d studs", math.floor(ent.DistancePlayer))
                    drawings.Distance.Position = Vector2.new(rootPos.X, boxY + height + 2)
                    drawings.Distance.Visible = true
                else
                    drawings.Distance.Visible = false
                end

                -- Dynamic Health Bar
                if Config.Features.ESP.HealthBar then
                    local barX = boxX - 6
                    local hpPct = math.clamp(ent.Health / ent.MaxHealth, 0, 1)
                    local barHeight = height * hpPct

                    drawings.HealthBarOutline.From = Vector2.new(barX, boxY - 1)
                    drawings.HealthBarOutline.To = Vector2.new(barX, boxY + height + 1)
                    drawings.HealthBarOutline.Visible = true

                    drawings.HealthBar.From = Vector2.new(barX, boxY + height)
                    drawings.HealthBar.To = Vector2.new(barX, boxY + height - barHeight)
                    drawings.HealthBar.Color = Color3.fromHSV(hpPct * 0.33, 1, 1)
                    drawings.HealthBar.Visible = true
                else
                    drawings.HealthBar.Visible = false
                    drawings.HealthBarOutline.Visible = false
                end

                -- Skeleton Hierarchy
                if Config.Features.ESP.Skeleton then
                    local lineIdx = 1
                    for _, joint in ipairs(SkeletonJoints) do
                        local p1 = ent.Bones[joint[1]]
                        local p2 = ent.Bones[joint[2]]
                        if p1 and p2 and lineIdx <= #drawings.SkeletonLines then
                            local sp1, vis1 = CurrentCamera:WorldToViewportPoint(p1.Position)
                            local sp2, vis2 = CurrentCamera:WorldToViewportPoint(p2.Position)
                            if vis1 and vis2 and sp1.Z > 0 and sp2.Z > 0 then
                                local line = drawings.SkeletonLines[lineIdx]
                                line.From = Vector2.new(sp1.X, sp1.Y)
                                line.To = Vector2.new(sp2.X, sp2.Y)
                                line.Color = Config.Features.ESP.SkeletonColor
                                line.Visible = true
                                lineIdx = lineIdx + 1
                            end
                        end
                    end
                    for i = lineIdx, #drawings.SkeletonLines do
                        drawings.SkeletonLines[i].Visible = false
                    end
                else
                    for _, l in ipairs(drawings.SkeletonLines) do l.Visible = false end
                end
            else
                drawings.Box.Visible = false
                drawings.BoxOutline.Visible = false
                drawings.Name.Visible = false
                drawings.Distance.Visible = false
                drawings.HealthBar.Visible = false
                drawings.HealthBarOutline.Visible = false
                for _, l in ipairs(drawings.SkeletonLines) do l.Visible = false end
            end
        end
    end

    -- Sweep dead or out-of-scope combatants
    for combatant, drawings in pairs(ESPRegistry) do
        if not presentCombatants[combatant] then
            drawings.Box:Remove()
            drawings.BoxOutline:Remove()
            drawings.Name:Remove()
            drawings.Distance:Remove()
            drawings.HealthBar:Remove()
            drawings.HealthBarOutline:Remove()
            for _, l in ipairs(drawings.SkeletonLines) do l:Remove() end
            ESPRegistry[combatant] = nil
        end
    end
end

-- ══════════════════════════════════════════════════════════════════════════════
-- §14 — EXECUTION LOOPS (HEARTBEAT & RENDERSTEPPED)
-- ══════════════════════════════════════════════════════════════════════════════

local RunConnections = {}
local AimbotHolding = false
local TriggerHolding = false

function Bloxstrike:StartLoops()
    self:InstallBypass()

    SilentFOVCircle = EnsureCircle("SilentFOV", Config.Features.SilentAim.FOVColor, Config.Features.SilentAim.FOV)
    AimFOVCircle = EnsureCircle("AimFOV", Config.Features.Aimbot.FOVColor, Config.Features.Aimbot.FOV)

    -- 1. Heartbeat: Backtrack record buffering & entity cache refresh
    table.insert(RunConnections, RunService.Heartbeat:Connect(function()
        self:UpdateBacktrackRecords()
    end))

    -- 2. RenderStepped: Visuals update & frame-perfect Silent Aim target resolution
    table.insert(RunConnections, RunService.RenderStepped:Connect(function(dt)
        self:UpdateVisuals()

        if Config.Features.SilentAim.Enabled then
            ActiveSilentTarget = self:ResolveTarget({
                FOV = Config.Features.SilentAim.FOV,
                TargetPart = Config.Features.SilentAim.TargetPart,
                VisibleOnly = Config.Features.SilentAim.VisibleOnly,
                PriorityMode = "ThreatPriority",
            })
        else
            ActiveSilentTarget = nil
        end

        -- Smooth camera aim assist
        if Config.Features.Aimbot.Enabled and AimbotHolding then
            local aimTarget = self:ResolveTarget({
                FOV = Config.Features.Aimbot.FOV,
                TargetPart = Config.Features.Aimbot.TargetPart,
                VisibleOnly = Config.Features.Aimbot.VisibleOnly,
                PriorityMode = Config.Features.Aimbot.TargetMode,
            })

            if aimTarget and aimTarget.ScreenPosition then
                local center = Vector2.new(CurrentCamera.ViewportSize.X / 2, CurrentCamera.ViewportSize.Y / 2)
                local delta = (aimTarget.ScreenPosition - center)
                local smooth = math.clamp(Config.Features.Aimbot.Smoothness, 0.01, 1.0)
                local moveVector = delta * (1 - smooth)

                if mousemoverel then
                    mousemoverel(moveVector.X, moveVector.Y)
                else
                    pcall(function()
                        VirtualInputManager:SendMouseMoveEvent(center.X + moveVector.X, center.Y + moveVector.Y, game)
                    end)
                end
            end
        end

        -- Triggerbot validation
        if Config.Features.Triggerbot.Enabled then
            local center = Vector2.new(CurrentCamera.ViewportSize.X / 2, CurrentCamera.ViewportSize.Y / 2)
            local triggerTarget = self:ResolveTarget({
                FOV = Config.Features.Triggerbot.FOVTolerance,
                TargetPart = "Head",
                VisibleOnly = Config.Features.Triggerbot.VisibleOnly,
                PriorityMode = "Crosshair",
            })

            if triggerTarget then
                if not TriggerHolding then
                    TriggerHolding = true
                    task.delay(Config.Features.Triggerbot.DelayMs / 1000, function()
                        if TriggerHolding then
                            pcall(function()
                                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                                if Config.Features.Triggerbot.Mode == "Tap" then
                                    task.wait(0.02)
                                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                                    TriggerHolding = false
                                end
                            end)
                        end
                    end)
                end
            else
                if TriggerHolding and Config.Features.Triggerbot.Mode == "Hold" then
                    TriggerHolding = false
                    pcall(function()
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                    end)
                end
            end
        end
    end))

    -- Keybind handling
    table.insert(RunConnections, UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            AimbotHolding = true
        end
    end))

    table.insert(RunConnections, UserInputService.InputEnded:Connect(function(input, gpe)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            AimbotHolding = false
        end
    end))
end

